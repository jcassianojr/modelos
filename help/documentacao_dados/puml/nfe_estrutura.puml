  VPIS : decimal(11,3)
  VIPI : decimal(11,3)
  VCOFINS : decimal(11,3)
  VBCICMS : decimal(11,3)
  VBCPIS : decimal(12,3)
  VBCIPI : decimal(11,3)
  VBCCOFINS : decimal(11,3)
  PICMS : decimal(6,2)
  PPIS : decimal(6,2)
