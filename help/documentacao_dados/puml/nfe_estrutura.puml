entity "cnpjxml" as cnpjxml {
  CNPJ : varchar(14)
  IE : varchar(14)
  NOME : varchar(60)
  ENDERECO : varchar(60)
  CIDADE : varchar(35)
  CEP : varchar(8)
  TELEFONE : varchar(14)
  DDD : varchar(2)
  UF : varchar(2)
  IESUBST : varchar(14)
  IMUNICIPAL : varchar(15)
  COGNOME : varchar(60)
  EMAIL : varchar(60)
  NUMEND : varchar(15)
  COMPLEM : varchar(30)
  BAIRRO : varchar(35)
  BACEN : varchar(5)
  PAIS : varchar(10)
  CNAE : varchar(7)
  SUFRAMA : varchar(9)
  CODIBGE : varchar(7)
  ULTIMAIMP : datetime
  CODPART : varchar(20)
  CSIT : varchar(1)
  INDCREDNFE : varchar(1)
  INDCREDCTE : varchar(1)
  XREGAPUR : varchar(7)
  DINIATIV : varchar(10)
  DULTSIT : varchar(10)
  DINIXML : datetime
  ENDTIP : varchar(10)
  --
  .. Índices ..
  + CNPJXML1 : CNPJ
  + CNPJXML2 : IE
  + CNPJXML3 : CODPART
  + CNPJXML4 : UF+CIDADE
}

